{
  "name": "tock",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @tock/server dev & bun run --filter @tock/web dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "tokens": "bun run --cwd packages/tokens build",
    "build": "bun run tokens && bun run --cwd apps/web build",
    "deploy": "bun run build && bun run --cwd apps/server deploy",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint --deny-warnings apps packages && bun scripts/lint-tokens.ts",
    "fmt": "oxfmt apps packages scripts",
    "fmt:check": "oxfmt --check apps packages scripts",
    "test": "bun run --cwd apps/server test",
    "budget": "bun scripts/budget.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run budget"
  },
  "devDependencies": {
    "oxlint": "^1.95.0",
    "oxfmt": "^0.80.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "agents@0.34.0": "patches/agents@0.34.0.patch"
  }
}
