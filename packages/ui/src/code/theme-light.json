{
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#1e1e1e",
    "foreground": "#1e1e1e",
    "editorCursor.foreground": "#3b5de8",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#3b5de833",
    "editorLineNumber.foreground": "#9c9c9d",
    "editorLineNumber.activeForeground": "#6a6a6b",
    "textLink.foreground": "#3b5de8",
    "gitDecoration.addedResourceForeground": "#338a31",
    "gitDecoration.untrackedResourceForeground": "#338a31",
    "gitDecoration.deletedResourceForeground": "#b9463f",
    "gitDecoration.modifiedResourceForeground": "#3b5de8",
    "gitDecoration.ignoredResourceForeground": "#9c9c9d"
  },
  "name": "tock-light",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#545c64"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "variable.language"
      ],
      "settings": {
        "foreground": "#00665f"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#6c40bc"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#24292e"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#1a682d"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#a82d39"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#a82d39"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#24292e"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source"
      ],
      "settings": {
        "foreground": "#032f62"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#00665f"
      }
    },
    {
      "scope": "meta.property-name",
      "settings": {
        "foreground": "#00665f"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#984106"
      }
    },
    {
      "scope": "variable.other",
      "settings": {
        "foreground": "#24292e"
      }
    },
    {
      "scope": "invalid.broken",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#b21d28"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#b21d28"
      }
    },
    {
      "scope": "invalid.illegal",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#b21d28"
      }
    },
    {
      "scope": "invalid.unimplemented",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#b21d28"
      }
    },
    {
      "scope": "carriage-return",
      "settings": {
        "background": "#ffeef0",
        "content": "^M",
        "fontStyle": "italic underline",
        "foreground": "#b21d28"
      }
    },
    {
      "scope": "message.error",
      "settings": {
        "foreground": "#b21d28"
      }
    },
    {
      "scope": "string variable",
      "settings": {
        "foreground": "#00665f"
      }
    },
    {
      "scope": [
        "source.regexp",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#032f62"
      }
    },
    {
      "scope": [
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": {
        "foreground": "#032f62"
      }
    },
    {
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#1a682d"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#00665f"
      }
    },
    {
      "scope": "support.variable",
      "settings": {
        "foreground": "#00665f"
      }
    },
    {
      "scope": "meta.module-reference",
      "settings": {
        "foreground": "#00665f"
      }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#984106"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#00665f"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#1a682d"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#24292e"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#24292e"
      }
    },
    {
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#00665f"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "background": "#ffeef0",
        "foreground": "#b21d28"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "background": "#f0fff4",
        "foreground": "#1a682d"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "background": "#ffebda",
        "foreground": "#984106"
      }
    },
    {
      "scope": [
        "markup.ignored",
        "markup.untracked"
      ],
      "settings": {
        "background": "#f0f5fa",
        "foreground": "#032f62"
      }
    },
    {
      "scope": "meta.diff.range",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6c40bc"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#00665f"
      }
    },
    {
      "scope": "meta.separator",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#00665f"
      }
    },
    {
      "scope": "meta.output",
      "settings": {
        "foreground": "#00665f"
      }
    },
    {
      "scope": [
        "brackethighlighter.tag",
        "brackethighlighter.curly",
        "brackethighlighter.round",
        "brackethighlighter.square",
        "brackethighlighter.angle",
        "brackethighlighter.quote"
      ],
      "settings": {
        "foreground": "#545c65"
      }
    },
    {
      "scope": "brackethighlighter.unmatched",
      "settings": {
        "foreground": "#b21d28"
      }
    },
    {
      "scope": [
        "constant.other.reference.link",
        "string.other.link"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#2a44af"
      }
    }
  ],
  "type": "light"
}
